msgid "Reset password"
msgstr "Resetovat heslo"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:62
msgid "Set password"
msgstr "Nastavit heslo"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:105
msgid "The two password fields didn’t match."
msgstr "Hesla se neshodují."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:109
#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:294
#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:330
msgid "Password"
msgstr "Heslo"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:109
msgid "Password confirmation"
msgstr "Potvrzení hesla"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:122
msgid "Enter the same password as before, for verification."
msgstr "Zadejte pro ověření stejné heslo jako předtím."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:166
msgid ""
"Whether the user will be able to authenticate using a password or not. If "
"disabled, they may still be able to authenticate using other backends, such "
"as Single Sign-On or LDAP."
msgstr ""
"Zda se uživatel bude moci ověřit pomocí hesla, nebo ne. Pokud je zakázáno, "
"může být stále schopen ověřit se pomocí jiných backendů, například Single "
"Sign-On nebo LDAP."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:174
msgid "Password-based authentication"
msgstr "Ověřování pomocí hesla"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:177
msgid "Enabled"
msgstr "Zapnuto"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:177
msgid "Disabled"
msgstr "Vypnuto"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:296
msgid ""
"Raw passwords are not stored, so there is no way to see the user’s password."
msgstr ""
"Neupravená hesla se neukládají, takže není možné zjistit heslo uživatele."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:312
msgid ""
"Enable password-based authentication for this user by setting a password."
msgstr ""
"Povolit ověřování na základě hesla pro tohoto uživatele nastavením hesla."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:337
#, python-format
msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"Zadejte správnou hodnotu pole %(username)s a heslo. Pozor, obě pole mohou "
"rozlišovat malá a velká písmena."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:340
msgid "This account is inactive."
msgstr "Tento účet je neaktivní."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:406
msgid "Email"
msgstr "E-mail"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:515
msgid "New password"
msgstr "Nové heslo"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:515
msgid "New password confirmation"
msgstr "Potvrzení nového hesla"

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:540
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Vaše současné heslo nebylo zadáno správně. Zkuste to znovu."

#: env/lib/python3.12/site-packages/django/contrib/auth/forms.py:544
msgid "Old password"
msgstr "Současné heslo"

