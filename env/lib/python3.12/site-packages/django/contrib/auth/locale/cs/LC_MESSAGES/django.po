#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:49
msgid "Personal info"
msgstr "Osobní údaje"

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:51
msgid "Permissions"
