msgstr "Vaše heslo nemůže být čistě číselné."

#: env/lib/python3.12/site-packages/django/contrib/auth/templates/registration/password_reset_subject.txt:2
#, python-format
msgid "Password reset on %(site_name)s"
msgstr "Obnovení hesla na webu %(site_name)s"

#: env/lib/python3.12/site-packages/django/contrib/auth/validators.py:12
msgid ""
"Enter a valid username. This value may contain only unaccented lowercase a-z "
"and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr ""
"Zadejte platné uživatelské jméno. Tato hodnota může obsahovat pouze malá "
"písmena bez diakritiky a-z a velká písmena A-Z, číslice a znaky @/./+/-/_."

#: env/lib/python3.12/site-packages/django/contrib/auth/validators.py:22
msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"Zadejte platné uživatelské jméno. Hodnota může obsahovat pouze písmena, "
"číslice a znaky @/./+/-/_."

