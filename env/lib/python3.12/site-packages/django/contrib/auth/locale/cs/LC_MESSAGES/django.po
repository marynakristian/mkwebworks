#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:161
#, python-format
msgid "%(name)s object with primary key %(key)r does not exist."
msgstr "Položka \"%(name)s\" s primárním klíčem \"%(key)r\" neexistuje."

#: env/lib/python3.12/site-packages/django/contrib/auth/admin.py:180
msgid "Conflicting form data submitted. Please try again."
msgstr "Odeslání protichůdných údajů z formuláře. Zkuste to prosím znovu."

